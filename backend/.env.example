# PostgreSQL connection string for the hosted database.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/NEON_DATABASE?sslmode=require

# Replace with a long, unique secret stored in the backend host's secret settings.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# JSON array of exact frontend origins. The defaults in app/config.py allow local Vite.
# For production, replace the example origin with the deployed frontend origin.
CORS_ORIGINS=["https://your-frontend.example.com"]
